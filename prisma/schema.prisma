generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id              String             @id @default(uuid()) @db.Uuid
  email           String?            @unique
  firstName       String?            @map("first_name")
  lastName        String?            @map("last_name")
  phone           String?
  avatarUrl       String?            @map("avatar_url")
  roleId          String?            @map("role_id") @db.Uuid
  isActive        Boolean            @default(true) @map("is_active")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  auditLogs       AuditLog[]
  logs            CommunicationLog[]
  addresses       CustomerAddress[]
  customer        Customer?
  notifications   Notification[]
  orders          Order[]
  role            Role?              @relation(fields: [roleId], references: [id])
  reviews         Review[]
  assignedTickets SupportTicket[]    @relation("TicketAssignee")
  assignedTasks   Task[]             @relation("TaskAssignee")
  createdTasks    Task[]             @relation("TaskCreator")
  sentMessages    TicketMessage[]
  bookmarks       UserBookmark[]

  @@index([roleId])
  @@map("profiles")
}

model Role {
  id          String           @id @default(uuid()) @db.Uuid
  name        String           @unique
  description String?
  isSystem    Boolean          @default(false) @map("is_system")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  profiles    Profile[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid()) @db.Uuid
  key         String           @unique
  name        String
  module      String
  description String?
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserBookmark {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  label     String
  href      String
  icon      String?
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      Profile  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, href])
  @@map("user_bookmarks")
}

model Notification {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  title     String
  message   String
  type      String    @default("system")
  linkUrl   String?   @map("link_url")
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      Profile?  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("notifications")
}

model Task {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String?
  status      String    @default("pending")
  priority    String    @default("medium")
  assigneeId  String?   @map("assignee_id") @db.Uuid
  createdById String?   @map("created_by") @db.Uuid
  dueDate     DateTime? @map("due_date") @db.Timestamptz(6)
  isDeleted   Boolean   @default(false) @map("is_deleted")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignee    Profile?  @relation("TaskAssignee", fields: [assigneeId], references: [id])
  creator     Profile?  @relation("TaskCreator", fields: [createdById], references: [id])

  @@map("tasks")
}

model Category {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  slug              String            @unique
  description       String?
  imageUrl          String?           @map("image_url")
  parentId          String?           @map("parent_id") @db.Uuid
  displayOrder      Int               @default(0) @map("display_order")
  isActive          Boolean           @default(true) @map("is_active")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent            Category?         @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children          Category[]        @relation("CategoryHierarchy")
  productCategories ProductCategory[]
  products          Product[]

  @@map("categories")
}

model Brand {
  id          String    @id @default(uuid()) @db.Uuid
  name        String
  slug        String    @unique
  logoUrl     String?   @map("logo_url")
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products    Product[]

  @@map("brands")
}

model Tag {
  id        String       @id @default(uuid()) @db.Uuid
  name      String
  slug      String       @unique
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  products  ProductTag[]

  @@map("tags")
}

model Product {
  id                String            @id @default(uuid()) @db.Uuid
  name              String
  slug              String            @unique
  description       String?
  shortDescription  String?           @map("short_description")
  basePrice         Decimal           @default(0) @map("base_price") @db.Decimal(12, 2)
  costPrice         Decimal?          @map("cost_price") @db.Decimal(12, 2)
  salePrice         Decimal?          @map("sale_price") @db.Decimal(12, 2)
  sku               String?           @unique
  barcode           String?           @unique
  status            String            @default("DRAFT")
  gender            String?
  season            String?
  careInstructions  String?           @map("care_instructions")
  countryOfOrigin   String?           @map("country_of_origin")
  isFeatured        Boolean           @default(false) @map("is_featured")
  isNewArrival      Boolean           @default(false) @map("is_new_arrival")
  rating            Decimal           @default(0) @db.Decimal(3, 2)
  reviewCount       Int               @default(0) @map("review_count")
  imageUrl          String?           @map("image_url")
  galleryUrls       String[]          @default([]) @map("gallery_urls")
  categoryId        String?           @map("category_id") @db.Uuid
  brandId           String?           @map("brand_id") @db.Uuid
  tags              String[]          @default([])
  deletedAt         DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  cartItems         CartItem[]
  orderItems        OrderItem[]
  productCategories ProductCategory[]
  media             ProductMedia[]
  seo               ProductSeo?
  productTags       ProductTag[]
  brand             Brand?            @relation(fields: [brandId], references: [id])
  category          Category?         @relation(fields: [categoryId], references: [id])
  reviews           Review[]
  variants          Variant[]
  wishlistItems     WishlistItem[]

  @@index([categoryId])
  @@index([brandId])
  @@index([status])
  @@index([deletedAt])
  @@index([createdAt])
  @@index([isFeatured])
  @@map("products")
}

model ProductCategory {
  productId  String   @map("product_id") @db.Uuid
  categoryId String   @map("category_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, categoryId])
  @@index([productId])
  @@index([categoryId])
  @@map("product_categories")
}

model ProductMedia {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  variantId    String?  @map("variant_id") @db.Uuid
  url          String
  urlWebp      String?  @map("url_webp")
  altText      String?  @map("alt_text")
  displayOrder Int      @default(0) @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")
  mediaType    String   @default("IMAGE") @map("media_type")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant      Variant? @relation(fields: [variantId], references: [id])

  @@index([productId])
  @@map("product_media")
}

model ProductSeo {
  id              String   @id @default(uuid()) @db.Uuid
  productId       String   @unique @map("product_id") @db.Uuid
  metaTitle       String?  @map("meta_title")
  metaDescription String?  @map("meta_description")
  canonicalUrl    String?  @map("canonical_url")
  ogTitle         String?  @map("og_title")
  ogDescription   String?  @map("og_description")
  ogImageUrl      String?  @map("og_image_url")
  twitterCardType String?  @map("twitter_card_type")
  structuredData  Json?    @map("structured_data")
  keywords        String[] @default([])
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_seo")
}

model ProductTag {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  tagId     String   @map("tag_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([productId, tagId])
  @@map("product_tags")
}

model Variant {
  id              String              @id @default(uuid()) @db.Uuid
  productId       String              @map("product_id") @db.Uuid
  sku             String              @unique
  barcode         String?             @unique
  priceOverride   Decimal?            @map("price_override") @db.Decimal(12, 2)
  salePrice       Decimal?            @map("sale_price") @db.Decimal(12, 2)
  costPrice       Decimal?            @map("cost_price") @db.Decimal(12, 2)
  weight          Decimal?            @db.Decimal(8, 2)
  attributes      Json                @default("{}")
  isActive        Boolean             @default(true) @map("is_active")
  createdAt       DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  cartItems       CartItem[]
  inventoryLevels InventoryLevel[]
  orderItems      OrderItem[]
  pickListItems   PickListItem[]
  media           ProductMedia[]
  poItems         PurchaseOrderItem[]
  returnItems     ReturnItem[]
  stockMovements  StockMovement[]
  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("variants")
}

model Warehouse {
  id              String           @id @default(uuid()) @db.Uuid
  name            String
  code            String           @unique
  address         String?
  city            String?
  state           String?
  postalCode      String?          @map("postal_code")
  country         String?          @default("BD")
  latitude        Float?
  longitude       Float?
  capacity        Int?
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  inventoryLevels InventoryLevel[]
  pickLists       PickList[]
  purchaseOrders  PurchaseOrder[]
  stockMovements  StockMovement[]

  @@map("warehouses")
}

model InventoryLevel {
  id                String    @id @default(uuid()) @db.Uuid
  variantId         String    @map("variant_id") @db.Uuid
  warehouseId       String    @map("warehouse_id") @db.Uuid
  quantityAvailable Int       @default(0) @map("quantity_available")
  quantityReserved  Int       @default(0) @map("quantity_reserved")
  reorderPoint      Int       @default(5) @map("reorder_point")
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  variant           Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse         Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([variantId, warehouseId])
  @@map("inventory_levels")
}

model StockMovement {
  id               String    @id @default(uuid()) @db.Uuid
  variantId        String    @map("variant_id") @db.Uuid
  warehouseId      String    @map("warehouse_id") @db.Uuid
  movementType     String    @map("movement_type")
  quantity         Int
  previousQuantity Int       @map("previous_quantity")
  newQuantity      Int       @map("new_quantity")
  referenceType    String?   @map("reference_type")
  referenceId      String?   @map("reference_id")
  notes            String?
  createdBy        String?   @map("created_by") @db.Uuid
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  variant          Variant   @relation(fields: [variantId], references: [id], onDelete: Cascade)
  warehouse        Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@map("stock_movements")
}

model Supplier {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  code           String          @unique
  contactName    String?         @map("contact_name")
  email          String?
  phone          String?
  address        String?
  isActive       Boolean         @default(true) @map("is_active")
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model Customer {
  id          String            @id @default(uuid()) @db.Uuid
  profileId   String?           @unique @map("profile_id") @db.Uuid
  name        String
  email       String            @unique
  phone       String?
  address     String?
  groupId     String?           @map("group_id") @db.Uuid
  status      String            @default("active")
  notes       String?
  totalSpent  Decimal           @default(0) @map("total_spent") @db.Decimal(12, 2)
  ordersCount Int               @default(0) @map("orders_count")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  addresses   CustomerAddress[]
  group       CustomerGroup?    @relation(fields: [groupId], references: [id])
  profile     Profile?          @relation(fields: [profileId], references: [id])
  orders      Order[]
  returns     Return[]

  @@map("customers")
}

model CustomerGroup {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  description String?
  isDynamic   Boolean    @default(false) @map("is_dynamic")
  rules       Json       @default("{}")
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customers   Customer[]

  @@map("customer_segments")
}

model CustomerAddress {
  id          String    @id @default(uuid()) @db.Uuid
  customerId  String?   @map("customer_id") @db.Uuid
  profileId   String?   @map("profile_id") @db.Uuid
  title       String    @default("Home")
  name        String
  phone       String
  addressLine String    @map("address_line")
  city        String
  state       String?
  postalCode  String?   @map("postal_code")
  country     String    @default("Bangladesh")
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  profile     Profile?  @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("customer_addresses")
}

model Order {
  id              String               @id @default(uuid()) @db.Uuid
  orderNumber     String               @unique @map("order_number")
  customerId      String?              @map("customer_id") @db.Uuid
  profileId       String?              @map("profile_id") @db.Uuid
  status          String               @default("PENDING")
  paymentStatus   String               @default("UNPAID") @map("payment_status")
  paymentMethod   String               @default("COD") @map("payment_method")
  paymentTxnId    String?              @map("payment_txn_id")
  subtotal        Decimal              @default(0) @db.Decimal(12, 2)
  discount        Decimal              @default(0) @db.Decimal(12, 2)
  shippingFee     Decimal              @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  totalAmount     Decimal              @default(0) @map("total_amount") @db.Decimal(12, 2)
  couponCode      String?              @map("coupon_code")
  notes           String?
  shippingAddress Json                 @map("shipping_address")
  billingAddress  Json?                @map("billing_address")
  trackingNumber  String?              @map("tracking_number")
  courier         String?
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items           OrderItem[]
  statusHistory   OrderStatusHistory[]
  customer        Customer?            @relation(fields: [customerId], references: [id])
  profile         Profile?             @relation(fields: [profileId], references: [id])
  payments        Payment[]
  returns         Return[]

  @@index([customerId])
  @@index([profileId])
  @@index([status])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(uuid()) @db.Uuid
  orderId     String   @map("order_id") @db.Uuid
  productId   String?  @map("product_id") @db.Uuid
  variantId   String?  @map("variant_id") @db.Uuid
  productName String   @map("product_name")
  variantName String?  @map("variant_name")
  sku         String
  quantity    Int      @default(1)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(12, 2)
  totalPrice  Decimal  @map("total_price") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product? @relation(fields: [productId], references: [id])
  variant     Variant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String   @id @default(uuid()) @db.Uuid
  orderId   String   @map("order_id") @db.Uuid
  status    String
  notes     String?
  changedBy String?  @map("changed_by") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_status_history")
}

model Payment {
  id              String   @id @default(uuid()) @db.Uuid
  orderId         String   @map("order_id") @db.Uuid
  amount          Decimal  @db.Decimal(12, 2)
  method          String
  status          String   @default("PENDING")
  transactionId   String?  @map("transaction_id")
  gatewayResponse Json?    @map("gateway_response")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model Cart {
  id               String            @id @default(uuid()) @db.Uuid
  userId           String?           @unique @map("user_id") @db.Uuid
  sessionId        String?           @map("session_id")
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items            CartItem[]
  checkoutSessions CheckoutSession[]

  @@index([sessionId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid()) @db.Uuid
  cartId    String   @map("cart_id") @db.Uuid
  productId String   @map("product_id") @db.Uuid
  variantId String?  @map("variant_id") @db.Uuid
  quantity  Int      @default(1)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   Variant? @relation(fields: [variantId], references: [id])

  @@unique([cartId, productId, variantId])
  @@map("cart_items")
}

model CheckoutSession {
  id                      String   @id @default(uuid()) @db.Uuid
  userId                  String?  @map("user_id") @db.Uuid
  guestEmail              String?  @map("guest_email")
  cartId                  String   @map("cart_id") @db.Uuid
  currentStep             String   @default("INFORMATION") @map("current_step")
  shippingAddressSnapshot Json?    @map("shipping_address_snapshot")
  billingAddressSnapshot  Json?    @map("billing_address_snapshot")
  shippingMethod          String?  @map("shipping_method")
  paymentMethod           String?  @map("payment_method")
  couponCode              String?  @map("coupon_code")
  expiresAt               DateTime @default(now()) @map("expires_at") @db.Timestamptz(6)
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  cart                    Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([userId])
  @@map("checkout_sessions")
}

model Wishlist {
  id        String         @id @default(uuid()) @db.Uuid
  userId    String         @unique @map("user_id") @db.Uuid
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items     WishlistItem[]

  @@map("wishlists")
}

model WishlistItem {
  id         String   @id @default(uuid()) @db.Uuid
  wishlistId String   @map("wishlist_id") @db.Uuid
  productId  String   @map("product_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  wishlist   Wishlist @relation(fields: [wishlistId], references: [id], onDelete: Cascade)

  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

model Review {
  id           String   @id @default(uuid()) @db.Uuid
  productId    String   @map("product_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  customerName String   @map("customer_name")
  rating       Int      @default(5)
  title        String?
  comment      String?
  images       String[] @default([])
  isApproved   Boolean  @default(true) @map("is_approved")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user         Profile? @relation(fields: [userId], references: [id])

  @@index([productId])
  @@map("reviews")
}

model Coupon {
  id             String    @id @default(uuid()) @db.Uuid
  code           String    @unique
  description    String?
  discountType   String    @default("PERCENTAGE") @map("discount_type")
  discountValue  Decimal   @map("discount_value") @db.Decimal(12, 2)
  minOrderAmount Decimal?  @map("min_order_amount") @db.Decimal(12, 2)
  maxDiscount    Decimal?  @map("max_discount") @db.Decimal(12, 2)
  usageLimit     Int?      @map("usage_limit")
  usedCount      Int       @default(0) @map("used_count")
  isActive       Boolean   @default(true) @map("is_active")
  startDate      DateTime? @map("start_date") @db.Timestamptz(6)
  endDate        DateTime? @map("end_date") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("coupons")
}

model Media {
  id          String   @id @default(uuid()) @db.Uuid
  filename    String
  storagePath String   @map("storage_path")
  publicUrl   String   @map("public_url")
  mimeType    String?  @map("mime_type")
  size        Int?
  width       Int?
  height      Int?
  bucket      String   @default("products")
  uploadedBy  String?  @map("uploaded_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([storagePath])
  @@map("media")
}

model CMSPage {
  id              String         @id @default(uuid()) @db.Uuid
  title           String
  slug            String         @unique
  content         String?
  metaTitle       String?        @map("meta_title")
  metaDescription String?        @map("meta_description")
  status          String         @default("DRAFT")
  isPublished     Boolean        @default(false) @map("is_published")
  publishedAt     DateTime?      @map("published_at") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  blocks          CMSPageBlock[]

  @@map("cms_pages")
}

model CMSPageBlock {
  id           String   @id @default(uuid()) @db.Uuid
  pageId       String   @map("page_id") @db.Uuid
  sectionType  String   @map("section_type")
  contentJson  Json     @default("{}") @map("content_json")
  displayOrder Int      @default(0) @map("display_order")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  page         CMSPage  @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("cms_page_blocks")
}

model Banner {
  id           String    @id @default(uuid()) @db.Uuid
  title        String?
  subtitle     String?
  ctaText      String?   @map("cta_text")
  linkUrl      String    @map("link_url")
  imageUrl     String    @map("image_url")
  altText      String?   @map("alt_text")
  placement    String    @default("HERO")
  displayOrder Int       @default(0) @map("display_order")
  isActive     Boolean   @default(true) @map("is_active")
  startDate    DateTime? @map("start_date") @db.Timestamptz(6)
  endDate      DateTime? @map("end_date") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("banners")
}

model BlogPost {
  id          String        @id @default(uuid()) @db.Uuid
  title       String
  slug        String        @unique
  excerpt     String?
  content     String
  coverImage  String?       @map("cover_image")
  categoryId  String?       @map("category_id") @db.Uuid
  authorId    String?       @map("author_id") @db.Uuid
  tags        String[]      @default([])
  status      String        @default("draft")
  publishedAt DateTime?     @map("published_at") @db.Timestamptz(6)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  category    BlogCategory? @relation(fields: [categoryId], references: [id])

  @@map("blog_posts")
}

model BlogCategory {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @unique
  slug        String     @unique
  description String?
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  posts       BlogPost[]

  @@map("blog_categories")
}

model Lead {
  id             String             @id @default(uuid()) @db.Uuid
  firstName      String             @map("first_name")
  lastName       String?            @map("last_name")
  email          String
  phone          String?
  company        String?            @map("company_name")
  source         String             @default("Direct")
  status         String             @default("new")
  assignedTo     String?            @map("assigned_to") @db.Uuid
  score          Int                @default(0)
  notes          String?
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime           @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  communications CommunicationLog[]

  @@index([email])
  @@map("crm_leads")
}

model CommunicationLog {
  id        String   @id @default(uuid()) @db.Uuid
  profileId String?  @map("profile_id") @db.Uuid
  leadId    String?  @map("lead_id") @db.Uuid
  type      String   @default("NOTE")
  direction String   @default("OUTBOUND")
  subject   String?
  content   String?
  status    String   @default("COMPLETED")
  senderId  String?  @map("sender_id") @db.Uuid
  metadata  Json     @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  profile   Profile? @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@map("communication_logs")
}

model SupportTicket {
  id              String          @id @default(uuid()) @db.Uuid
  ticketNumber    String?         @unique @map("ticket_number")
  customerId      String?         @map("customer_id") @db.Uuid
  assignedAgentId String?         @map("assigned_agent_id") @db.Uuid
  subject         String
  description     String
  priority        String          @default("medium")
  status          String          @default("OPEN")
  category        String          @default("GENERAL")
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  assignedAgent   Profile?        @relation("TicketAssignee", fields: [assignedAgentId], references: [id])
  messages        TicketMessage[]

  @@map("support_tickets")
}

model TicketMessage {
  id         String        @id @default(uuid()) @db.Uuid
  ticketId   String        @map("ticket_id") @db.Uuid
  senderId   String?       @map("sender_id") @db.Uuid
  senderType String        @default("CUSTOMER") @map("sender_type")
  body       String
  isInternal Boolean       @default(false) @map("is_internal")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  sender     Profile?      @relation(fields: [senderId], references: [id])
  ticket     SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@map("ticket_messages")
}

model Campaign {
  id            String    @id @default(uuid()) @db.Uuid
  name          String
  type          String    @default("email")
  subject       String?
  content       String?
  targetSegment String    @default("all") @map("target_segment")
  status        String    @default("draft")
  scheduleTime  DateTime? @map("schedule_time") @db.Timestamptz(6)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  metadata      Json      @default("{}")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("marketing_campaigns")
}

model PurchaseOrder {
  id           String              @id @default(uuid()) @db.Uuid
  poNumber     String              @unique @map("po_number")
  supplierId   String?             @map("supplier_id") @db.Uuid
  warehouseId  String              @map("warehouse_id") @db.Uuid
  status       String              @default("DRAFT")
  totalAmount  Decimal             @default(0) @map("total_amount") @db.Decimal(12, 2)
  expectedDate DateTime?           @map("expected_date") @db.Timestamptz(6)
  notes        String?
  createdBy    String?             @map("created_by") @db.Uuid
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items        PurchaseOrderItem[]
  supplier     Supplier?           @relation(fields: [supplierId], references: [id])
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(uuid()) @db.Uuid
  purchaseOrderId String        @map("purchase_order_id") @db.Uuid
  variantId       String        @map("variant_id") @db.Uuid
  quantity        Int
  unitCost        Decimal       @map("unit_cost") @db.Decimal(12, 2)
  totalCost       Decimal       @map("total_cost") @db.Decimal(12, 2)
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  variant         Variant       @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("purchase_order_items")
}

model PickList {
  id               String         @id @default(uuid()) @db.Uuid
  pickListNumber   String         @unique @map("pick_list_number")
  warehouseId      String         @map("warehouse_id") @db.Uuid
  orderId          String?        @map("order_id") @db.Uuid
  assignedPickerId String?        @map("assigned_picker_id") @db.Uuid
  status           String         @default("PENDING")
  startedAt        DateTime?      @map("started_at") @db.Timestamptz(6)
  completedAt      DateTime?      @map("completed_at") @db.Timestamptz(6)
  notes            String?
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items            PickListItem[]
  warehouse        Warehouse      @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@map("pick_lists")
}

model PickListItem {
  id               String   @id @default(uuid()) @db.Uuid
  pickListId       String   @map("pick_list_id") @db.Uuid
  variantId        String   @map("variant_id") @db.Uuid
  quantityRequired Int      @map("quantity_required")
  quantityPicked   Int      @default(0) @map("quantity_picked")
  status           String   @default("PENDING")
  location         String?
  pickList         PickList @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  variant          Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("pick_list_items")
}

model Return {
  id           String       @id @default(uuid()) @db.Uuid
  returnNumber String       @unique @map("return_number")
  orderId      String?      @map("order_id") @db.Uuid
  customerId   String?      @map("customer_id") @db.Uuid
  status       String       @default("REQUESTED")
  reason       String?
  notes        String?
  refundAmount Decimal      @default(0) @map("refund_amount") @db.Decimal(12, 2)
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime     @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  items        ReturnItem[]
  customer     Customer?    @relation(fields: [customerId], references: [id])
  order        Order?       @relation(fields: [orderId], references: [id])

  @@map("returns")
}

model ReturnItem {
  id          String   @id @default(uuid()) @db.Uuid
  returnId    String   @map("return_id") @db.Uuid
  orderItemId String?  @map("order_item_id") @db.Uuid
  variantId   String?  @map("variant_id") @db.Uuid
  quantity    Int      @default(1)
  reason      String?
  condition   String   @default("good")
  restocked   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  return      Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)
  variant     Variant? @relation(fields: [variantId], references: [id])

  @@map("return_items")
}

model Setting {
  id          String   @id @default(uuid()) @db.Uuid
  key         String   @unique
  value       Json
  category    String?  @default("general")
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user      Profile? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@map("audit_logs")
}
